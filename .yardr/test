#!/bin/sh
# The iPhone simulator gate; UI/instrumentation and iPad runs are by hand. The
# repository's script tests (scripts/test-*.py) run ahead of it, on every run.
# A suite name (sh .yardr/test PushRegisterTests) runs that FootplateTests suite
# alone on the simulator, under the same lock: an xcodebuild typed by hand on
# the simulator takes no lock and can kill a gate run's test host. A named run
# that executes no tests fails, and a skipped test is not an executed one:
# xcodebuild ends a name that matches nothing, or a suite that skips every
# test, in TEST SUCCEEDED.
# A missing destination must fail rather than silently testing another phone.
# A screenshot suite takes its directory as TEST_RUNNER_<X>_SHOTS_DIR; a bare
# <X>_SHOTS_DIR is refused before anything runs, as xcodebuild would drop it.
set -e
# A second name would be dropped without a word, and the pass would hide it.
if [ "$#" -gt 1 ]; then
  echo "usage: sh .yardr/test [Suite]: one suite at a time" >&2
  exit 1
fi
# xcodebuild hands the test host only the variables that carry a TEST_RUNNER_
# prefix, and strips it, so a screenshot directory set bare (CREW_SHOTS_DIR) is
# dropped without a word: the run passes and the PNGs are nowhere. A bare name
# fails here instead, naming the form that arrives, and is not renamed for the
# caller: the variable xcodebuild takes stays the one that is typed. A bare
# name whose TEST_RUNNER_ twin is set too passes, as the twin is what arrives.
# awk reads the names from ENVIRON, as a value holding a newline could pass for
# a line of env's output; the names it prints are capitals, digits and
# underscores, so the loop splits them safely. This sits right after the usage
# check, ahead of the icons and the script tests, so a refusal waits for none
# of them and never reaches the simulator.
bare=$(awk '
  BEGIN {
    for (var in ENVIRON)
      if (var ~ /^[A-Z0-9_]+_SHOTS_DIR$/ && var !~ /^TEST_RUNNER_/ &&
          !(("TEST_RUNNER_" var) in ENVIRON))
        print var
  }
')
for var in $bare; do
  echo "$var is set, and xcodebuild drops it before the test host: set TEST_RUNNER_$var (the suite reads it as $var)" >&2
done
[ -z "$bare" ] || exit 1
# App Store Connect refuses a large icon with an alpha channel, so every PNG
# in the app icon set must be opaque.
for icon in Footplate/UI/Resources/Assets.xcassets/AppIcon.appiconset/*.png; do
  if [ -f "$icon" ] && sips -g hasAlpha "$icon" | grep -q 'hasAlpha: yes'; then
    echo "alpha channel in $icon" >&2
    exit 1
  fi
done
# The script tests hold the stand-ins to the Swift they read: scripts/fake-edge
# parses FootplateTests/FakeYard/Canned.swift line by line, and a reshaped
# answer table once made it refuse to start with this gate green
# (footplate-ios-e0ka). They are hermetic and take seconds, so they run on every
# run, a named suite's included: a broken tree must fail loud here, not pass for
# the one suite it names. They need no simulator, so they run before the lock: a
# failing one neither waits behind a simulator run nor holds it up. The first to
# fail ends the run, named, with its own status. Unlike the icons above there is
# no [ -f ] guard: a glob that matches nothing hands python3 the pattern itself,
# which fails, as no script tests at all is no pass.
for script in scripts/test-*.py; do
  python3 "$script" || {
    rc=$?
    echo "gate: SCRIPT TEST FAILED (exit $rc): $script" >&2
    exit "$rc"
  }
done
# Every run installs and launches the same app on the one simulator, so two at
# once (two worktrees, or a worktree and a landing) kill each other's test host
# ("Test crashed with signal kill") though no test failed. So hold a lock from
# before xcodebuild to its end. getconf names the directory, not $TMPDIR, which
# an environment may move or unset, and a lock split in two is no lock. -o keeps
# the lock off xcodebuild's children, so a daemon it leaves behind cannot hold
# it on. Without flock the run fails rather than going unlocked.
if ! command -v flock >/dev/null; then
  echo "flock not found: the gate runs one simulator test at a time under it (brew install flock)" >&2
  exit 1
fi
lock="$(getconf DARWIN_USER_TEMP_DIR)footplate-ios-sim.lock"
sim=7EC91353-EDF5-4E93-B644-46A44BA6CFCB
# Shared: two runs starting together must not read each other's probe as a run.
flock -s -n "$lock" true || echo "waiting for another run on the simulator ($lock)" >&2
# A cold simulator that xcodebuild boots for itself can refuse the app's launch
# with Busy before any test runs (footplate-ios-ts3d). So under the lock, boot it
# and wait until it is ready first; bootstatus returns at once for one that is.
# xcodebuild shuts down only a simulator it booted itself, so this one stays
# booted after the run: leave it, the next run starts warm. The quoted script is
# the inner shell's own: its $1 is the simulator, its $@ the xcodebuild arguments.
# The bare run and a named one both go through this function, so the lock, the
# boot and the destination have one copy: its own $1, if any, is the suite.
gate() {
  flock -o "$lock" sh -ec '
    xcrun simctl bootstatus "$1" -b
    shift
    exec xcodebuild test "$@"
  ' sh "$sim" \
    -project Footplate.xcodeproj \
    -scheme Footplate \
    -destination "platform=iOS Simulator,id=$sim" \
    -only-testing:"FootplateTests${1:+/$1}" \
    -resultBundlePath "$bundle"
}
# Every run keeps its output and its result bundle in one temp dir: a failure
# that names no failing test is diagnosed from the bundle instead, so the dir
# stays behind an xcodebuild failure and goes after anything else.
tmpdir=$(mktemp -d)
log=$tmpdir/gate.log
status=$tmpdir/gate.status
bundle=$tmpdir/Footplate.xcresult
trap 'rm -rf "$tmpdir"' EXIT
# tee shows the output as it comes and keeps it in a file to count from. sh has
# no pipefail, so the pipe's status is tee's: the subshell writes xcodebuild's to
# a second file, with set +e so that the set -e above cannot end it before.
(set +e; gate "$@"; echo $? >"$status") | tee "$log"
rc=$(cat "$status")
if [ "$rc" != 0 ]; then
  trap - EXIT
  echo "gate: TEST FAILED (exit ${rc:-1}); bundle: $bundle" >&2
  # A failure that names its failing tests needs nothing more than the bundle's
  # path; one that names none (a killed test host fails mute) prints what the
  # bundle holds instead, so the next reader starts from a cause, not a verdict.
  if ! grep -q "Test Case .* failed" "$log"; then
    if [ -d "$bundle" ]; then
      if ! xcrun xcresulttool get test-results summary --path "$bundle" 2>/dev/null | grep -E '"(result|passedTests|failedTests|skippedTests|failureText|testName)"' >&2; then
        echo "gate: the bundle's summary is unreadable; open the bundle above" >&2
      fi
    else
      echo "gate: no result bundle was written" >&2
    fi
  fi
  exit "${rc:-1}"
fi
if [ "$#" -eq 1 ]; then
  # A name that matches nothing runs 0 tests, and xcodebuild still prints TEST
  # SUCCEEDED and exits 0, so a named run must show it executed some.
  # XCTest prints its count on stdout, says "Executed 1 test" for one, and
  # counts a skipped test in N ("Executed 3 tests, with 1 test skipped and 0
  # failures"). So a line passes when N is above its M skipped (0 where it has
  # no such clause), which one grep cannot say; one passing line is enough, as
  # a log has a line per suite and a total. A log with none fails, and so does
  # one Apple rewords, a "skipped" in any other shape included: that breaks
  # loud, where a count read loosely would reopen the hole without a word.
  # POSIX awk only: this Mac's has no three-argument match or gensub.
  if ! awk '
    function num(s) {
      sub(/^[^0-9]*/, "", s)
      sub(/[^0-9].*$/, "", s)
      return s + 0
    }
    match($0, /Executed [0-9]+ tests?/) {
      n = num(substr($0, RSTART, RLENGTH))
      m = 0
      if (match($0, /with [0-9]+ tests? skipped/))
        m = num(substr($0, RSTART, RLENGTH))
      else if ($0 ~ /skipped/)
        next
      if (n > m)
        ok = 1
    }
    END { exit !ok }
  ' "$log"; then
    echo "$1: no tests ran (no \"Executed N tests\" line with N above the tests skipped):" \
      "is the name right, or is every test skipped?" >&2
    exit 1
  fi
fi
